<template id="mediaSelectorTemplate">
	<div class="mediaSelectContainer">
		<aside>
				<label id="wrap_tree_filter">
					<input id="treeViewFilter" type="search" placeholder="Filter">
				</label>

				<nav aria-label="Directory Structure">
					<div id="mediapoolTree" class="wb-skeleton wb-initializing wb-fade-expander"></div>
				</nav>
			</aside>

			<div class="mediaSelectMain">
				<div class="mediaSelectToolbar">
					<button type="button" id="addSelectedToPlaylist" disabled>
						<i class="bi bi-plus-lg" aria-hidden="true"></i>
						Add to playlist
						<span id="mediaSelectionCount" class="media-selection-count" hidden></span>
					</button>
					<span class="mediaSelectHint">Click to multi-select · Shift+click for a range · or drag onto the playlist</span>
				</div>
				<section id="mediaList" class="media-list-grid-view" aria-labelledby="media-list-title">

				</section>
			</div>
	</div>
</template>

<template id="mediaTemplate">
	<article class="media-item" draggable="true">
		<figure draggable="false">
			<img src="" alt="Media Thumbnail" draggable="false">
			<i class="media-type-icon bi" draggable="false"></i>
			<figcaption class="media-filename" draggable="false">
			</figcaption>
		</figure>
	</article>
</template>
