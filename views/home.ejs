<%- include('partials/header') %>

<main>
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1.25rem;">
    <div>
      <h1 style="margin-bottom:0.25rem; color:var(--gh-primary-color); display:flex; align-items:center; gap:0.5rem;">
        <i class="bi bi-speedometer2"></i> Garlic-Hub Digital Signage Dashboard
      </h1>
      <div style="font-size:0.9rem; color:#555;">
        SMIL-compatible Digital Signage Content & Player Fleet Orchestration
      </div>
    </div>
    <div style="display:flex; gap:0.5rem;">
      <a href="/player" class="button add-unit" style="text-decoration:none;"><i class="bi bi-plus-lg"></i> Add Player</a>
      <a href="/playlists" class="button" style="text-decoration:none;"><i class="bi bi-collection-play"></i> New Playlist</a>
      <a href="/mediapool" class="button" style="text-decoration:none;"><i class="bi bi-cloud-arrow-up"></i> Upload Media</a>
    </div>
  </div>

  <!-- Metric Overview Grid -->
  <div class="metric-grid">
    <div class="metric-card">
      <div class="metric-icon"><i class="bi bi-display"></i></div>
      <div class="metric-info">
        <div class="metric-value"><%= stats.onlinePlayers %> / <%= stats.totalPlayers %></div>
        <div class="metric-label">Active Players Online</div>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-icon"><i class="bi bi-collection-play"></i></div>
      <div class="metric-info">
        <div class="metric-value"><%= stats.totalPlaylists %></div>
        <div class="metric-label">Configured Playlists</div>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-icon"><i class="bi bi-images"></i></div>
      <div class="metric-info">
        <div class="metric-value"><%= stats.totalMedia %></div>
        <div class="metric-label">Mediapool Assets</div>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-icon"><i class="bi bi-cpu"></i></div>
      <div class="metric-info">
        <div class="metric-value">SMIL 3.0</div>
        <div class="metric-label">Player Feed Protocol</div>
      </div>
    </div>
  </div>

  <div style="display:grid; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
    <!-- Left Column: Player Fleet Overview -->
    <div class="main-element-group" style="margin-top:0;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1rem; border-bottom: 1px solid var(--gh-border-color); padding-bottom: 0.5rem;">
        <h2 style="margin:0; color:var(--gh-primary-color); display:flex; align-items:center; gap:0.5rem;">
          <i class="bi bi-display"></i> Digital Signage Players
        </h2>
        <a href="/player" style="font-size:0.85rem; font-weight:bold;">View All Players &rarr;</a>
      </div>

      <ul class="results-listing">
        <li class="results-header">
          <span style="width:30px;"></span>
          <span style="flex:2;">Device / Name</span>
          <span style="flex:1.5;">Model & IP</span>
          <span style="flex:2;">Current Playlist</span>
          <span style="width:120px; text-align:right;">Actions</span>
        </li>
        <% players.forEach(function(p) { %>
          <li class="results-body">
            <span style="width:30px;">
              <span class="status-pill status-pill--<%= p.status === 'online' ? 'online' : (p.status === 'standby' ? 'standby' : 'offline') %>" style="padding:0.15rem; width:10px; height:10px; border-radius:50%; display:inline-block;" title="<%= p.status %>"></span>
            </span>
            <span style="flex:2; font-weight:bold;">
              <a href="/player/edit/<%= p.player_id %>" style="color:var(--gh-primary-color);"><%= p.player_name %></a>
              <div style="font-size:0.75rem; color:#777; font-weight:normal;">Resolution: <%= p.resolution %></div>
            </span>
            <span style="flex:1.5; font-size:0.85rem;">
              <div><%= p.model %></div>
              <div style="color:#666; font-family:monospace;"><%= p.ip %></div>
            </span>
            <span style="flex:2; font-size:0.85rem;">
              <span class="mode-badge"><%= p.playlist_name %></span>
            </span>
            <span style="width:120px; text-align:right;">
              <form action="/player/push/<%= p.player_id %>" method="POST" style="display:inline;">
                <button type="submit" class="unit-action" title="Push Update to Player">
                  <i class="bi bi-arrow-repeat"></i>
                </button>
              </form>
              <a href="/smil-index?player_id=<%= p.player_id %>" target="_blank" class="unit-action" title="Inspect SMIL XML Feed">
                <i class="bi bi-file-earmark-code"></i>
              </a>
              <a href="/player/edit/<%= p.player_id %>" class="unit-action" title="Settings">
                <i class="bi bi-gear"></i>
              </a>
            </span>
          </li>
        <% }); %>
      </ul>
    </div>

    <!-- Right Column: System Status & SMIL Player Integration Guide -->
    <div>
      <div class="main-element-group" style="margin-top:0;">
        <h2 style="margin-top:0; color:var(--gh-primary-color); display:flex; align-items:center; gap:0.5rem; border-bottom: 1px solid var(--gh-border-color); padding-bottom: 0.5rem;">
          <i class="bi bi-broadcast"></i> Hardware Connect
        </h2>
        <p style="font-size:0.85rem; line-height:1.5; color:#444;">
          Point any SMIL-compliant hardware media player (e.g. IAdea, Qbic, Giada, Raspberry Pi running Garlic-Player) to the endpoint below:
        </p>
        <div style="background:#f4f6f8; border:1px solid #d0d7de; border-radius:4px; padding:0.6rem; font-family:monospace; font-size:0.8rem; word-break:break-all; margin-bottom:1rem; user-select:all;">
          <%= hostUrl %>/smil-index
        </div>
        <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.85rem;">
          <a href="/smil-index" target="_blank" class="button" style="text-decoration:none;"><i class="bi bi-box-arrow-up-right"></i> Open SMIL Feed</a>
          <span style="color:var(--gh-success-fg); font-weight:bold;"><i class="bi bi-check-circle"></i> Service Ready</span>
        </div>
      </div>

      <div class="main-element-group">
        <h2 style="margin-top:0; color:var(--gh-primary-color); display:flex; align-items:center; gap:0.5rem; border-bottom: 1px solid var(--gh-border-color); padding-bottom: 0.5rem;">
          <i class="bi bi-activity"></i> Recent Activity
        </h2>
        <ul style="list-style:none; padding:0; margin:0; font-size:0.85rem; display:flex; flex-direction:column; gap:0.75rem;">
          <li style="display:flex; gap:0.6rem;">
            <i class="bi bi-check2-circle" style="color:var(--gh-success-fg); font-size:1.1rem;"></i>
            <div>
              <div>Playlist <strong>hurzi</strong> synced to <strong>Lobby 4K Display</strong></div>
              <div style="font-size:0.75rem; color:#888;">2 minutes ago</div>
            </div>
          </li>
          <li style="display:flex; gap:0.6rem;">
            <i class="bi bi-cloud-arrow-up" style="color:var(--gh-info-fg); font-size:1.1rem;"></i>
            <div>
              <div>Media asset <strong>abu-dhabi-mosque.jpg</strong> cataloged</div>
              <div style="font-size:0.75rem; color:#888;">14 minutes ago</div>
            </div>
          </li>
          <li style="display:flex; gap:0.6rem;">
            <i class="bi bi-person-check" style="color:var(--gh-primary-color); font-size:1.1rem;"></i>
            <div>
              <div>User <strong>admin</strong> session established</div>
              <div style="font-size:0.75rem; color:#888;">Today at 10:15</div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
